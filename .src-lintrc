{
  "version": 1,
  "strict": true,
  "boundaries": {
    "app": { "root": "app" },
    "tests": { "root": "tests", "allow": ["app/**", "scripts/**", "packages/server/**"] },
    "server": { "root": "packages/server", "allow": ["app/graph/snapshot/**", "app/graph/types.ts", "app/graph/constants.ts", "app/graph/render/index.ts", "app/lib/cli/utils.ts", "app/lib/cli/types.ts"] },
    "scripts": { "root": "scripts" }
  }
}
