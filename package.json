{
  "name": "m2rd",
  "version": "0.0.15",
  "private": true,
  "description": "m2rd — Mermaid to React Diagrams",
  "author": "Jeff Wainwright <me@jeffry.in> (https://jeffry.in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yowainwright/m2rd"
  },
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "scripts": {
    "cli": "node tmp/cli/m2rd-cli.mjs",
    "preview:styleguide": "pnpm run cli:build && node tmp/cli/m2rd-cli.mjs --styleguide",
    "cli:build": "rolldown --config scripts/cli/rolldown.config.ts",
    "cli:pack": "node scripts/cli/index.ts",
    "dev": "printf '\\n  App: http://localhost:%s/m2rd/\\n\\n' \"${M2RD_APP_PORT:-54783}\" && next dev --port ${M2RD_APP_PORT:-54783}",
    "build": "next build --webpack",
    "preview": "mkdir -p .next/cache/pages && ln -sfn ../../../out .next/cache/pages/m2rd && python3 -m http.server ${M2RD_PREVIEW_PORT:-54784} --bind 127.0.0.1 --directory .next/cache/pages",
    "release": "release-it patch",
    "release:dry": "release-it patch --dry-run",
    "deps:check": "codependence",
    "deps:overrides": "pastoralist",
    "deps:security": "pastoralist --dry-run --checkSecurity --hasWorkspaceSecurityChecks --strict",
    "deps:audit": "pnpm audit",
    "format": "oxfmt -c scripts/.oxfmtrc.json --write . '!next-env.d.ts' '!pnpm-lock.yaml' '!AGENTS.md'",
    "format:check": "oxfmt -c scripts/.oxfmtrc.json --check . '!next-env.d.ts' '!pnpm-lock.yaml' '!AGENTS.md'",
    "lint": "pnpm run lint:all",
    "lint:all": "pnpm run lint:fs && pnpm run lint:src && pnpm run lint:oxlint && pnpm run lint:shell",
    "lint:ci": "pnpm run lint:fs && pnpm run lint:src && pnpm run format:check && pnpm run lint:oxlint:strict && pnpm run lint:shell:ci",
    "lint:fs": "fs-lint check --root . --config scripts/.fs-lintrc --base \"${FS_LINT_BASE:-HEAD}\" && (git diff --no-renames --diff-filter=A --name-only -z HEAD && git ls-files --others --exclude-standard -z) | fs-lint check --root . --config scripts/.fs-lintrc --stdin0",
    "lint:src": "git ls-files --cached --others --exclude-standard --deduplicate -z -- app tests scripts ':!:app/components/ui/**' | xargs -0 -n 1 sh -c 'test ! -f \"$1\" || src-lint check \"$1\"' sh",
    "lint:oxlint": "oxlint -c scripts/oxlint.config.ts app tests scripts",
    "lint:oxlint:strict": "oxlint -c scripts/oxlint.config.ts --deny-warnings app tests scripts",
    "lint/run": "pnpm run lint:all",
    "lint/session": "pnpm run lint:fs && pnpm run lint:src && pnpm run format:check && pnpm run lint:oxlint:strict && pnpm run lint:shell",
    "lint/session/all": "pnpm run lint/session",
    "lint/setup": "sh scripts/setup.sh --hooks-only",
    "lint:shell": "shfmt -d scripts/setup.sh && pnpm run lint:shell:ci && shellcheck-legibility check --config scripts/.shellcheck-legibility.toml scripts/setup.sh",
    "lint:shell:ci": "shellcheck -x -S warning scripts/setup.sh",
    "mcp:generate": "node scripts/mcp/index.ts",
    "mcp:check": "node \"$HOME/.agents/lib/mcp/client.js\" --config .agents/mcp/shadcn.json shadcn get_item_examples_from_registries '{\"registries\":[\"@shadcn\"],\"query\":\"resizable-demo\"}'",
    "typecheck": "pnpm run typecheck:mcp && tsc --noEmit",
    "typecheck:mcp": "tsc --ignoreConfig --noEmit --module nodenext --target esnext --types node --allowImportingTsExtensions --skipLibCheck scripts/mcp/*.ts tests/unit/scripts/mcp/*.test.ts",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "TMPDIR=.next/cache PLAYWRIGHT_LAST_RUN_OUTPUT_FILE=.next/cache/playwright/.last-run.json playwright test --config scripts/playwright.config.ts",
    "test:integration": "TMPDIR=.next/cache vitest run --config scripts/vitest.config.mts tests/integration",
    "test:mcp": "node --test tests/unit/scripts/mcp/*.test.ts",
    "test:unit": "pnpm run test:mcp && TMPDIR=.next/cache vitest run --config scripts/vitest.config.mts tests/unit",
    "update": "pnpm run update:deps && pnpm install",
    "update:deps": "codependence --update",
    "validate": "pnpm run lint/session && pnpm run typecheck && pnpm run cli:build && pnpm run test && pnpm run build",
    "setup": "sh scripts/setup.sh",
    "prepare": "sh scripts/setup.sh prepare",
    "postinstall": "pastoralist"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "codependence": {
    "config": {
      "app": {
        "path": "package.json",
        "manager": "pnpm",
        "mode": "precise",
        "lockfile": true
      }
    }
  },
  "dependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.43.13",
    "@pinojs/redact": "^0.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.25.12",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-lang-mermaid": "^0.5.0",
    "dexie": "4.4.6",
    "dompurify": "3.4.16",
    "effect": "^3.22.2",
    "elkjs": "0.12.0",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "ink": "^7.1.1",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "marked": "18.0.14",
    "mermaid": "^12.0.0",
    "motion": "^13.4.6",
    "next": "^16.3.8",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "reactflow": "^11.11.4",
    "shaders": "^3.2.475",
    "string-width": "8.3.0",
    "svgdom": "0.1.29",
    "tailwind-merge": "^3.7.0",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svgdom": "0.1.2",
    "autoprefixer": "^10.6.1",
    "codependence": "^1.0.15",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-plugin-legibility": "^0.0.5",
    "pastoralist": "^1.13.5",
    "postcss": "^8.5.28",
    "release-it": "21.1.0",
    "rolldown": "^1.2.12",
    "rollup-plugin-license": "^3.7.1",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): ${version}",
      "tagName": "v${version}",
      "push": false
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": [
        "pnpm run lint/session",
        "pnpm run typecheck",
        "pnpm run test",
        "pnpm run deps:security",
        "pnpm run deps:audit"
      ]
    }
  },
  "pastoralist": {
    "appendix": {
      "lodash-es@4.18.1": {
        "dependents": {
          "m2rd": "lodash-es (required by @chevrotain/cst-dts-gen, @chevrotain/gast, chevrotain)"
        },
        "ledger": {
          "addedDate": "2026-09-15T21:47:22.982Z",
          "reason": "Replace Mermaid/Chevrotain's vulnerable lodash-es pin for GHSA-r5fr-rjxr-66jc and GHSA-f23m-r3pf-42rh. Remove when upstream resolves a patched version without this override.",
          "url": "https://github.com/advisories/GHSA-r5fr-rjxr-66jc"
        }
      },
      "undici@7.29.0@7.29.1": {
        "dependents": {
          "m2rd": "undici@7.29.0 (required by @dotenvx/dotenvx, jsdom, release-it)"
        },
        "ledger": {
          "addedDate": "2026-09-30T05:27:17.253Z",
          "reason": "Replace release-it 21.0.3's vulnerable undici 7.29.0 pin with 7.29.1. Remove when release-it declares a patched version. Scoped to 7.29.0 to preserve other undici versions.",
          "source": "security",
          "url": "https://github.com/advisories/GHSA-rfgv-xxqx-mfg5",
          "patchedVersion": "7.29.1"
        }
      }
    }
  },
  "peerDependencies": {},
  "optionalDependencies": {}
}
